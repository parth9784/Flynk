NODE_ENV=development
PORT=5000
# Comma-separated list — add every dev surface that needs CORS/Socket.IO
# access (web client, Expo web, LAN IP variants for phone/browser testing).
CLIENT_URL=http://localhost:5173,http://localhost:8081

DATABASE_URL=postgresql://postgres:password@localhost:5433/p2p_share
REDIS_URL=redis://localhost:6380

ANONYMOUS_SESSION_TTL_HOURS=4

JWT_SECRET=replace_with_secure_secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

MAX_FILE_SIZE_MB=1024
MAX_ANONYMOUS_FILE_SIZE_MB=500
MAX_FILES_PER_TRANSFER=20
SHARE_EXPIRY_MINUTES=15
