{
  "name": "p2p-file-share",
  "private": true,
  "workspaces": [
    "packages/*",
    "client",
    "server",
    "mobile"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:mobile": "npm run start --workspace=mobile",
    "build": "npm run build --workspaces --if-present"
  }
}
