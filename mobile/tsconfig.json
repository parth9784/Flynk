{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Metro resolves .web.ts/.native.ts per build platform at bundle time;
    // tsc doesn't do that automatically, so point it at the native variant
    // for typechecking (both variants satisfy the same MinimalPeerConnection
    // shape App.tsx relies on, so this doesn't hide real platform bugs there).
    "moduleSuffixes": [".native", ""]
  }
}
